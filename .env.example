# Django
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# ML inference service (external ml_services/ on Server 2 — HTTP client only)
ML_SERVICE_URL=http://127.0.0.1:8100
ML_SERVICE_PUBLIC_URL=http://127.0.0.1:8100
ML_SERVICE_TIMEOUT=60
# Inference weights/GPU settings live in ml_services/.env
FRONTEND_ORIGIN=http://localhost:5173

# Background worker — saves ML detections while system runs (no browser needed)
DETECTION_WORKER_ENABLED=True
DETECTION_WORKER_AUTO_START=True
DETECTION_WORKER_INTERVAL_SEC=2
DETECTION_WORKER_CAMERA_REFRESH_SEC=60




ATTENDANCE_FACE_MIN_CONFIDENCE=0.25
ATTENDANCE_CAMERA_MARK_COOLDOWN_SECONDS=120
ATTENDANCE_MIN_CHECKOUT_HOURS=4
ATTENDANCE_MIN_CHECKOUT_AFTER_IN_MINUTES=1
ATTENDANCE_WORK_START=09:00
ATTENDANCE_LATE_AFTER=09:30
ATTENDANCE_MIN_ENROLLMENT_IMAGES=5
ATTENDANCE_WEBCAM_SIMILARITY_THRESHOLD=0.45
ATTENDANCE_CCTV_SIMILARITY_THRESHOLD=0.38
# Start CCTV attendance workers automatically when the server boots
ATTENDANCE_CCTV_AUTOSTART=True
ATTENDANCE_INSIGHTFACE_MODEL=buffalo_l
# Optional: force providers e.g. CPUExecutionProvider or DmlExecutionProvider,CPUExecutionProvider
ATTENDANCE_ONNX_PROVIDERS=
ATTENDANCE_MARK_ON_FACE_RECOGNITION_CAMERAS=True
ATTENDANCE_MARK_ON_ALL_CAMERAS=False
ATTENDANCE_SNAPSHOT_ENABLED=True
ATTENDANCE_VIDEO_SECONDS=7
ATTENDANCE_VIDEO_FPS=15
ATTENDANCE_VIDEO_WIDTH=1280
ATTENDANCE_VIDEO_JPEG_QUALITY=95
ATTENDANCE_VIDEO_CRF=18

# Person Journey — ML journey pipeline (track+ReID) + live staff detections
PERSON_JOURNEY_LIVE_INGEST_ENABLED=True
PERSON_JOURNEY_LIVE_INGEST_INTERVAL_SEC=2
PERSON_JOURNEY_LIVE_CAMERA_REFRESH_SEC=60
# When journey ML pipeline is on, live ingest skips unknowns by default (pipeline uses track+ReID).
# Leave blank for auto: off when pipeline active, on when pipeline unreachable.
PERSON_JOURNEY_LIVE_INGEST_UNKNOWN_ENABLED=
PERSON_JOURNEY_WORKER_ENABLED=True
PERSON_JOURNEY_SYNC_INTERVAL_SEC=60
PERSON_JOURNEY_BACKEND_URL=http://127.0.0.1:8000
PERSON_JOURNEY_INGEST_TOKEN=
PERSON_JOURNEY_INGEST_DEDUP_SECONDS=3
JOURNEY_FACE_MATCH_THRESHOLD=0.72
JOURNEY_REID_MATCH_THRESHOLD=0.68
JOURNEY_COMBINED_MATCH_THRESHOLD=0.75
JOURNEY_MAX_TRAVEL_SECONDS=120
JOURNEY_RECENT_WINDOW_SECONDS=600
# 3840 = 4K; 0 = native camera resolution (no scale). Native RTSP main stream is preferred.
JOURNEY_SNAPSHOT_WIDTH=3840
JOURNEY_SNAPSHOT_JPEG_QUALITY=98
JOURNEY_SNAPSHOT_FULL_FRAME=True
JOURNEY_SNAPSHOT_NATIVE=True